# ============================================
# POS Prima Motor — Environment Variables
# ============================================
# Copy ke .env.local lalu isi nilainya:
#   cp .env .env.local
#
# Sumber nilai: Supabase Dashboard → Settings → API / Database
# ============================================

# URL project Supabase (https://xxx.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://vwzyvyforkmposubboeh.supabase.co

# Anon key — aman untuk client/frontend
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key — RAHASIA, hanya server
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Connection pooler (port 6543, mode transaction)
# Dari: Supabase → Settings → Database → Connection string → URI
DATABASE_URL=postgresql://postgres.vwzyvyforkmposubboeh:[YOUR-PASSWORD]@aws-1-ap-southeast-2.pooler.supabase.com:6543/postgres?pgbouncer=true