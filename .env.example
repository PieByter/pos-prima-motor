# ============================================
# POS Prima Motor — Environment Variables
# ============================================
# Copy file ini ke .env.local lalu isi nilainya.
#   cp .env.example .env.local
#
# Dapatkan nilai dari:
#   Supabase Dashboard → Project Settings → API
# ============================================

# ── Supabase (Client & Server) ──────────────────────────────────────────────
# URL project Supabase (https://xxx.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Anon/public key (aman untuk frontend)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key (RAHASIA — hanya untuk server/admin)
SUPABASE_SERVICE_ROLE_KEY=

# ── Database (Drizzle ORM) ──────────────────────────────────────────────────
# Connection string PostgreSQL untuk migrasi.
# Format: postgresql://user:password@host:port/database?sslmode=require
# Dari Supabase: Project Settings → Database → Connection string (URI)
DATABASE_URL=
