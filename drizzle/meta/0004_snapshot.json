  "views": {
    "public.stock_summary": {
      "columns": {
        "item_id": {
          "name": "item_id",
          "type": "integer",
          "primaryKey": false,
          "notNull": false
        },
        "name": {
          "name": "name",
          "type": "text",
          "primaryKey": false,
          "notNull": false
        },
        "sku": {
          "name": "sku",
          "type": "text",
          "primaryKey": false,
          "notNull": false
        },
        "category": {
          "name": "category",
          "type": "text",
          "primaryKey": false,
          "notNull": false
        },
        "total_in": {
          "name": "total_in",
          "type": "integer",
          "primaryKey": false,
          "notNull": false
        },
        "total_out": {
          "name": "total_out",
          "type": "integer",
          "primaryKey": false,
          "notNull": false
        },
        "current_stock": {
          "name": "current_stock",
          "type": "integer",
          "primaryKey": false,
          "notNull": false
        }
      },
      "definition": "SELECT\n  i.id AS item_id,\n  i.name,\n  i.sku,\n  i.category,\n  COALESCE(SUM(CASE WHEN sm.type = 'IN' THEN sm.quantity ELSE 0 END), 0) AS total_in,\n  COALESCE(SUM(CASE WHEN sm.type = 'OUT' THEN sm.quantity ELSE 0 END), 0) AS total_out,\n  COALESCE(SUM(CASE WHEN sm.type = 'IN' THEN sm.quantity ELSE -sm.quantity END), 0) AS current_stock\nFROM items i\nLEFT JOIN stock_movements sm ON sm.item_id = i.id\nGROUP BY i.id, i.name, i.sku, i.category",
      "name": "stock_summary",
      "schema": "public",
      "isExisting": false,
      "materialized": false
    }
  },
